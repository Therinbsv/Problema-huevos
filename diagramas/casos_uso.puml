@startuml casos_uso
' Diagrama de casos de uso — Ciclo 1 (Concepto, hito LCO)
' Responsable: Arquitecto y modelador | Issue: HUEVO-4
' Trazabilidad: docs/ciclo1_requerimientos.md (RF-01 a RF-10)

title Problema de los huevos — Casos de uso (v2.0, Ciclo 4)
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FDFBF7
  BorderColor #555555
}

actor "Usuario\n(docente / evaluador)" as U

rectangle "Simulador del problema de los huevos" {
  usecase "UC-01 Elegir huevos (H);\nedificio fijo de 100 pisos (N)\n[RF-01]" as UC01
  usecase "UC-02 Validar entradas\n[RF-09]" as UC02
  usecase "UC-03 Calcular peor caso\nde búsqueda lineal\n[RF-02]" as UC03
  usecase "UC-04 Calcular peor caso\nde búsqueda binaria\n[RF-03]" as UC04
  usecase "UC-05 Calcular mínimo\nde lanzamientos\n[RF-04]" as UC05
  usecase "UC-06 Ver secuencia de pisos\nde la estrategia óptima\n[RF-05]" as UC06
  usecase "UC-07 Comparar estrategias\n(pestaña Comparar)\n[RF-06]" as UC07
  usecase "UC-08 Simular: jugar una partida\n(pestaña Simular)\n[RF-07]" as UC08
  usecase "UC-09 Ver gráfico de\nlanzamientos vs. huevos\n(pestaña Gráfico)\n[RF-08]" as UC09
  usecase "UC-10 Ver explicación y paso a paso\nde cada estrategia\n(pestaña Cómo funciona)\n[RF-10]" as UC10
  usecase "UC-11 Cambiar cantidad\nde huevos (1 a 7)" as UC11
}

U --> UC01
U --> UC07
U --> UC08
U --> UC09
U --> UC10
U --> UC11

UC01 ..> UC02 : <<include>>
UC07 ..> UC01 : <<include>>
UC07 ..> UC03 : <<include>>
UC07 ..> UC04 : <<include>>
UC07 ..> UC05 : <<include>>
UC06 ..> UC07 : <<extend>>
UC08 ..> UC01 : <<include>>
UC09 ..> UC03 : <<include>>
UC09 ..> UC04 : <<include>>
UC09 ..> UC05 : <<include>>
UC10 ..> UC02 : <<include>>
UC11 ..> UC02 : <<include>>

note right of UC05
  La estrategia óptima alcanza el mínimo
  (decidido en los Ciclos 2–3).
end note

note bottom of UC08
  App final: la pestaña Simular es una partida
  interactiva (el usuario lanza huevos desde un piso
  y compara con la óptima). El paso a paso de cada
  estrategia está en la pestaña Cómo funciona.
end note

@enduml
